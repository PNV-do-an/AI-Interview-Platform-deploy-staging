# Dung cho `docker compose` trong repo nay.  Sao chép: cp .env.example .env
#
# Trong docker network, backend goi db qua ten dich vu `db` cong 3306.
# Chay backend ngoai container (mvn spring-boot:run) thi dung .env.example
# cua repo BE: DB_HOST=localhost, DB_PORT=3307.

# Database
DB_HOST=db
DB_PORT=3306
DB_NAME=ai_interview_db
# Tai khoan app mà backend dung
DB_USERNAME=aiuser
DB_PASSWORD=aipassword
# MYSQL_ROOT_PASSWORD va cap tai khoan luc mysql:8.0 khoi tao
MYSQL_ROOT_PASSWORD=admin123
DB_APP_USERNAME=aiuser
DB_APP_PASSWORD=aipassword

# JWT
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Google OAuth (Google Cloud Console -> Credentials -> OAuth Client ID)
GOOGLE_CLIENT_ID=

# GitHub OAuth (GitHub Settings -> Developer settings -> OAuth Apps; callback http://localhost:3000/login)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# SMTP (dang ky + quen mat khau)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Enterprise SSO (OIDC generic IdP: Keycloak/Entra/Okta). De trong = nut SSO tat
SSO_OIDC_ISSUER=http://localhost:8180/realms/ai-interview
SSO_OIDC_BASE_URL=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
# Chi email thuoc cac domain nay duoc dang nhap SSO. De trong = moi email da verify
SSO_ALLOWED_EMAIL_DOMAINS=acme.com
SSO_REDIRECT_URI=http://localhost:3000/login
SSO_KEYCLOAK_ADMIN_PASSWORD=admin
